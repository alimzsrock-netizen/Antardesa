<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Uji Ongkir V4 | AntarDesa</title>
<style>
*{box-sizing:border-box}body{margin:0;background:#f5f8f6;color:#20352a;font-family:Arial,sans-serif}header{background:#16805d;color:#fff;padding:22px 18px;border-radius:0 0 20px 20px}header h1{margin:0;font-size:23px}header p{font-size:13px;line-height:1.5}main{max-width:540px;margin:auto;padding:18px 14px 60px}.card{background:#fff;border:1px solid #dce7df;border-radius:14px;padding:17px;margin-bottom:15px}label{display:block;font-weight:bold;font-size:13px;margin:14px 0 7px}input{width:100%;padding:12px;border:1px solid #b8cbbf;border-radius:9px;font:inherit}button{border:0;border-radius:9px;padding:12px 14px;font-weight:bold;cursor:pointer;background:#16805d;color:#fff}button.secondary{background:#e8f4ee;color:#176849}button:disabled{opacity:.55;cursor:not-allowed}.actions{display:grid;gap:10px;margin-top:16px}.help{font-size:12px;color:#5e7165;line-height:1.6}.status{white-space:pre-wrap;overflow-wrap:anywhere;font-size:13px;line-height:1.6}.error{color:#b91c1c}.success{color:#126a4b}.result{font-size:19px;font-weight:bold;color:#126a4b}a{color:#16805d}[hidden]{display:none!important}
</style>
</head>
<body>
<header><h1>🛵 Uji Ongkir V4</h1><p>Halaman pengembangan AntarDesa. Hanya estimasi, tidak membuat pesanan.</p></header>
<main>
<section class="card">
<strong>1. Pemeriksaan sesi pelanggan</strong>
<p id="sessionStatus" class="status" role="status">Memeriksa sesi...</p>
<button id="retrySession" class="secondary" type="button">Periksa Sesi Lagi</button>
<p class="help">Gunakan browser dan domain dev yang sama dengan dashboard pelanggan. Jangan tempelkan token ke halaman atau percakapan.</p>
</section>
<section class="card">
<strong>2. Produk pengujian</strong>
<p>Beras 5kg | ID produk:</p>
<p class="help" style="overflow-wrap:anywhere">78d7fd22-27fb-4d66-98f5-ab3b06814edd</p>
<strong>3. Titik tujuan uji</strong>
<p class="help">Masukkan koordinat tujuan yang memang kamu pilih untuk pengujian. Jangan menggunakan titik acak. Lokasi GPS opsional dan hanya diambil setelah izin diberikan.</p>
<label for="latitude">Latitude tujuan</label>
<input id="latitude" type="number" inputmode="decimal" step="any" min="-90" max="90" placeholder="Contoh format: -4.000000">
<label for="longitude">Longitude tujuan</label>
<input id="longitude" type="number" inputmode="decimal" step="any" min="-180" max="180" placeholder="Contoh format: 103.000000">
<div class="actions">
<button id="gps" class="secondary" type="button">📍 Isi dari GPS perangkat (opsional)</button>
<button id="estimate" type="button" disabled>Hitung Estimasi Ongkir</button>
</div>
<p id="message" class="status" role="status" aria-live="polite"></p>
<div id="result" hidden>
<p class="help">Jarak rute jalan</p><p id="distance" class="result"></p>
<p class="help">Estimasi ongkir</p><p id="fee" class="result"></p>
<p id="serviceArea" class="help"></p>
<p class="help">Ini bukan penawaran harga final. Checkout V4 belum aktif.</p>
</div>
</section>
<p class="help"><a href="pelanggan.html">Kembali ke dashboard pelanggan</a></p>
</main>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/dist/umd/supabase.min.js"></script>
<script>
"use strict";
const SUPABASE_URL="https://gswlkajcizcvrhcfabtg.supabase.co";
const SUPABASE_PUBLISHABLE_KEY="sb_publishable_fYFVBQDDVi3qrdVYq45I4Q_C4MTqN63";
const PRODUCT_ID="78d7fd22-27fb-4d66-98f5-ab3b06814edd";
const $=id=>document.getElementById(id);
const client=window.supabase.createClient(SUPABASE_URL,SUPABASE_PUBLISHABLE_KEY);
let ready=false,busy=false;
function message(text,error=false){$("message").textContent=text;$("message").className="status"+(error?" error":"");}
async function checkSession(){ready=false;$("estimate").disabled=true;$("sessionStatus").textContent="Memeriksa sesi...";try{const {data,error}=await client.auth.getUser();if(error||!data?.user)throw new Error("Sesi login tidak ditemukan. Buka dashboard pelanggan dan login dari browser yang sama.");ready=true;$("sessionStatus").textContent="✅ Sesi pengguna valid. Siap melakukan uji estimasi.";$("sessionStatus").className="status success";$("estimate").disabled=false;}catch(e){$("sessionStatus").textContent="❌ "+e.message;$("sessionStatus").className="status error";}}
$("retrySession").addEventListener("click",checkSession);
$("gps").addEventListener("click",()=>{if(!navigator.geolocation){message("GPS tidak tersedia di browser ini.",true);return;}$("gps").disabled=true;message("Meminta izin lokasi perangkat...");navigator.geolocation.getCurrentPosition(pos=>{$("latitude").value=String(pos.coords.latitude);$("longitude").value=String(pos.coords.longitude);$("gps").disabled=false;message("Koordinat tujuan terisi. Periksa kembali sebelum menguji.");},err=>{$("gps").disabled=false;message("GPS gagal atau izin ditolak: "+err.message,true);},{enableHighAccuracy:true,timeout:15000,maximumAge:0});});
$("estimate").addEventListener("click",async()=>{if(!ready||busy)return;$("result").hidden=true;const latText=$("latitude").value.trim(),lonText=$("longitude").value.trim();const lat=Number(latText),lon=Number(lonText);if(!latText||!lonText||!Number.isFinite(lat)||!Number.isFinite(lon)||lat < -90||lat >90||lon < -180||lon >180){message("Masukkan latitude dan longitude tujuan yang valid.",true);return;}busy=true;$("estimate").disabled=true;message("Memvalidasi sesi dan meminta estimasi rute...");try{const {data:sessionData,error:sessionError}=await client.auth.getSession();if(sessionError||!sessionData?.session?.access_token)throw new Error("Sesi tidak tersedia. Login kembali.");const {data:userData,error:userError}=await client.auth.getUser();if(userError||!userData?.user)throw new Error("Sesi tidak valid. Login kembali.");const response=await fetch(SUPABASE_URL+"/functions/v1/antardesa-shipping-v4",{method:"POST",headers:{"Content-Type":"application/json","apikey":SUPABASE_PUBLISHABLE_KEY,"Authorization":"Bearer "+sessionData.session.access_token},body:JSON.stringify({action:"estimate",product_id:PRODUCT_ID,delivery_latitude:lat,delivery_longitude:lon})});let payload;try{payload=await response.json();}catch{throw new Error("Server mengembalikan respons bukan JSON (HTTP "+response.status+").");}if(!response.ok)throw new Error("HTTP "+response.status+": "+(payload.error||payload.message||"Permintaan ditolak"));if(payload.status!=="estimate"||payload.checkout_enabled!==false||typeof payload.delivery_fee!=="number"||typeof payload.distance_km!=="number")throw new Error("Format hasil estimasi server tidak sesuai.");$("distance").textContent=payload.distance_km.toLocaleString("id-ID")+" km";$("fee").textContent="Rp "+payload.delivery_fee.toLocaleString("id-ID");$("serviceArea").textContent="Wilayah konfigurasi: "+String(payload.service_area||"-");$("result").hidden=false;message("Estimasi berhasil. Tidak ada transaksi yang dibuat.");}catch(e){message(e.message||"Gagal menguji estimasi.",true);}finally{busy=false;$("estimate").disabled=!ready;}});
checkSession();
</script>
</body>
</html>
